{
  "name": "a-s-restaurant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/lib/tsc.js -b && node ./node_modules/vite/bin/vite.js build",
    "postbuild": "node scripts/gh-pages-spa-fallback.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "preview:gh": "node ./node_modules/vite/bin/vite.js preview --base /AS-FilipinoRestaurant.io/",
    "deploy": "npm run build && node ./node_modules/gh-pages/bin/gh-pages.js -d dist",
    "lint": "node ./node_modules/eslint/bin/eslint.js ."
  },
  "homepage": "https://astridbonoan.github.io/AS-FilipinoRestaurant.io/",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
